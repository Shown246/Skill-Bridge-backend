datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  STUDENT
  TUTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  phone         String?
  role          UserRole   @default(STUDENT)
  status        UserStatus @default(ACTIVE)
  sessions      Session[]
  accounts      Account[]

  // Relations
  tutorProfile      TutorProfile?
  approvedTutors    TutorProfile[]         @relation("ApprovedByAdmin")
  studentBookings   Booking[]              @relation("StudentBookings")
  cancelledBookings Booking[]              @relation("CancelledByActor")
  statusHistory     BookingStatusHistory[]
  reviews           Review[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Jwks {
  id          String   @id
  publicKey   String
  privateKey  String
  createdAt   DateTime

  @@map("jwks")
}

enum TutorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model TutorProfile {
  id              String              @id @default(uuid())
  userId          String              @unique
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline        String
  bio             String
  experienceYears Int                 @default(0)
  hourlyRate      Decimal             @db.Decimal(10, 2)
  currencyCode    String              @default("USD")
  approvalStatus  TutorApprovalStatus @default(PENDING)
  rejectionReason String?
  approvedAt      DateTime?
  approvedById    String?
  approvedBy      User?               @relation("ApprovedByAdmin", fields: [approvedById], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // Relations
  categories      TutorCategory[]
  availability    WeeklyAvailability[]
  bookings        Booking[]
  reviews         Review[]

  @@index([approvalStatus])
  @@index([hourlyRate])
  @@map("tutor_profile")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tutors      TutorCategory[]
  bookings    Booking[]

  @@map("category")
}

model TutorCategory {
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  categoryId     String
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([tutorProfileId, categoryId])
  @@map("tutor_category")
}

model WeeklyAvailability {
  id             String       @id @default(uuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  dayOfWeek      Int          // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startMinuteUtc Int          // 0 to 1439
  endMinuteUtc   Int          // 1 to 1440
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([tutorProfileId, dayOfWeek])
  @@map("weekly_availability")
}

enum BookingStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Booking {
  id                 String                 @id @default(uuid())
  studentId          String
  student            User                   @relation("StudentBookings", fields: [studentId], references: [id], onDelete: Cascade)
  tutorProfileId     String
  tutorProfile       TutorProfile           @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  categoryId         String
  category           Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  startAt            DateTime
  endAt              DateTime
  durationMinutes    Int
  hourlyRateSnapshot Decimal                @db.Decimal(10, 2)
  quotedPrice        Decimal                @db.Decimal(10, 2)
  currencyCode       String                 @default("USD")
  note               String?
  status             BookingStatus          @default(CONFIRMED)
  cancelledAt        DateTime?
  cancelledById      String?
  cancelledBy        User?                  @relation("CancelledByActor", fields: [cancelledById], references: [id])
  cancellationReason String?
  completedAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  statusHistory      BookingStatusHistory[]
  review             Review?

  @@index([studentId, startAt])
  @@index([tutorProfileId, startAt])
  @@index([status, startAt])
  @@index([categoryId])
  @@map("booking")
}

model BookingStatusHistory {
  id          String         @id @default(uuid())
  bookingId   String
  booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus  BookingStatus?
  toStatus    BookingStatus
  actorUserId String
  actorUser   User           @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  actorRole   UserRole
  reason      String?
  createdAt   DateTime       @default(now())

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

model Review {
  id             String       @id @default(uuid())
  bookingId      String       @unique
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  studentId      String
  student        User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  rating         Int
  comment        String
  createdAt      DateTime     @default(now())

  @@map("review")
}

